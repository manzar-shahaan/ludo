{
  "name": "ludo",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx --tsconfig tsconfig.server.json server/index.ts",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "lodash-es": "^4.17.21",
    "mersenne-twister": "^1.1.0",
    "qrcode-svg": "^1.1.0",
    "tsx": "^4.21.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "vuex": "^4.1.0",
    "vuex-persist": "^3.1.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "sass": "^1.75.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.0"
  }
}
