{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "server/**/*.ts",
    "src/net/**/*.ts",
    "src/types/**/*.ts",
    "src/store/initials/**/*.ts",
    "src/constants.ts"
  ]
}
